{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com')",
      ".indexOn": [
        "createdAt",
        "sellerKey"
      ]
    },
    "views": {
      ".read": true,
      "$productId": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
      }
    },
    "orders": {
      ".read": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (query.orderByChild === 'trackCode' && query.equalTo != null && query.limitToFirst === 1)",
      ".indexOn": [
        "trackCode"
      ],
      "$orderId": {
        ".write": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (!data.exists() && newData.child('status').val() === 'pendiente' && newData.child('trackCode').isString() && newData.child('items').exists())"
      }
    },
    "sellers": {
      ".read": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (auth != null && query.orderByChild === 'uid' && query.equalTo === auth.uid) || (auth != null && auth.token.email_verified === true && query.orderByChild === 'email' && query.equalTo === auth.token.email)",
      ".indexOn": [
        "uid",
        "email"
      ],
      "$sellerId": {
        ".read": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (auth != null && data.child('uid').val() === auth.uid)",
        ".write": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (auth != null && !data.exists() && newData.child('uid').val() === auth.uid && newData.child('email').val() === auth.token.email && newData.child('status').val() === 'pending' && !newData.child('password').exists()) || (auth != null && auth.token.email_verified === true && data.exists() && !data.child('uid').exists() && data.child('email').val() === auth.token.email && newData.child('uid').val() === auth.uid && newData.child('status').val() === data.child('status').val() && newData.child('email').val() === data.child('email').val() && !newData.child('password').exists())"
      }
    },
    "sellerProducts": {
      ".read": "auth != null",
      ".indexOn": [
        "sellerKey"
      ],
      "$itemId": {
        ".write": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (auth != null && (!data.exists() || root.child('sellers/' + data.child('sellerKey').val() + '/uid').val() === auth.uid) && (!newData.exists() || (root.child('sellers/' + newData.child('sellerKey').val() + '/uid').val() === auth.uid && newData.child('approved').val() !== true)))"
      }
    },
    "stores": {
      ".read": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com')",
      "$storeId": {
        ".read": true,
        ".write": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com')"
      }
    },
    "events": {
      ".read": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com')",
      "$storeId": {
        "$eventId": {
          ".write": "!data.exists() && newData.exists() && root.child('stores/' + $storeId).exists()",
          ".validate": "newData.hasChildren(['t', 'ts']) && newData.child('t').isString() && newData.child('t').val().matches(/^(visit|view|ask|order)$/) && newData.child('ts').isNumber()",
          "t": {
            ".validate": true
          },
          "ts": {
            ".validate": true
          },
          "p": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "v": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "leads": {
      ".read": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com')",
      "$storeId": {
        "$leadId": {
          ".write": "(auth != null && auth.token.email === 'raulbenitez563@gmail.com') || (!data.exists() && newData.exists() && root.child('stores/' + $storeId).exists())",
          ".validate": "newData.hasChildren(['type', 'ts']) && newData.child('type').isString() && newData.child('type').val().matches(/^(pedido|consulta)$/) && newData.child('ts').isNumber()",
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 60"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "notes": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "delivery": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          }
        }
      }
    }
  }
}
